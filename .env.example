# Copy to .env.local for local dev, and add the same vars in Vercel Project Settings.

# Gemini (primary — free tier is generous, web search via google_search grounding)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Current free-tier model (gemini-2.5-flash is being retired to new keys).
GEMINI_MODEL=gemini-3.6-flash

# Groq (fallback — free tier, built-in web search via groq/compound)
# Get a key: https://console.groq.com/keys
# NOTE: Groq's free tier caps ~6,000 tokens/min. Because groq/compound injects
# web-search results into the request, heavy searches can hit a 413. Upgrading
# the Groq tier (or using it as fallback only) avoids this.
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# Which provider to try first: "gemini" or "groq"
PRIMARY_PROVIDER=gemini
